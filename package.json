{
  "name": "trading-sim",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "test": "npm run test --workspace web",
    "check": "npm run check --workspace web",
    "format": "prettier --write \"web/src/**/*.{ts,tsx,css}\" web/vite.config.ts scripts/dev.mjs",
    "format:check": "prettier --check \"web/src/**/*.{ts,tsx,css}\" web/vite.config.ts scripts/dev.mjs"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
